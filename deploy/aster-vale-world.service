[Unit]
Description=Aster Vale authoritative EO world
After=network.target

[Service]
User=astervale
Group=astervale
WorkingDirectory=/opt/aster-vale/runtime
ExecStart=/opt/aster-vale/runtime/etheos
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/aster-vale/runtime
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=384M
TasksMax=96
UMask=0077
[Install]
WantedBy=multi-user.target
