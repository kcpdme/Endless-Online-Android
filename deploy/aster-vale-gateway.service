[Unit]
Description=Aster Vale native EO adapter
After=network.target aster-vale-world.service
Requires=aster-vale-world.service
[Service]
User=astervale
Group=astervale
WorkingDirectory=/opt/aster-vale/app/server
ExecStart=/usr/bin/python3 /opt/aster-vale/app/server/gateway.py
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
Environment=ASTER_VALE_SHORTCUT_DB=/opt/aster-vale/preferences/shortcuts.sqlite3
ReadWritePaths=/opt/aster-vale/preferences

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=160M
TasksMax=96
UMask=0077
[Install]
WantedBy=multi-user.target
