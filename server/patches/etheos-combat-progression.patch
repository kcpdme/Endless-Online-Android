+double Character::BasicAttackSeconds() const
+{
+    if (!this->world->config["CombatProgression"] || this->clas != 5) return 0.5;
+    const EIF_Data& bow = this->world->eif->Get(this->paperdoll[Weapon]);
+    const EIF_Data& arrows = this->world->eif->Get(this->paperdoll[Shield]);
+    if (bow.subtype != EIF::Ranged || arrows.subtype != EIF::Arrows || !this->BalanceCanEquip(bow) || !this->BalanceCanEquip(arrows)) return 0.5;
+    auto entry = this->world->config.find("BalanceItem."+util::to_string(bow.id)+".attack_speed");
+    return 0.5 / (entry == this->world->config.end() ? 1.0 : util::clamp<double>(entry->second,1.0,2.0));
+}
+
+double Character::RangedShotPower() const
+{
+    if (!this->world->config["CombatProgression"] || this->clas != 5) return 1.0;
+    auto entry = this->world->config.find("BalanceItem."+util::to_string(this->paperdoll[Weapon])+".shot_power");
+    return entry == this->world->config.end() ? 1.0 : util::clamp<double>(entry->second,0.5,1.0);
+}
+
+int Character::WeaponRange() const
+{
+    const EIF_Data& bow = this->world->eif->Get(this->paperdoll[Weapon]);
+    if (bow.subtype != EIF::Ranged) return 1;
+    if (!this->world->config["CombatProgression"]) return int(this->world->config["RangedDistance"]);
+    const EIF_Data& arrows = this->world->eif->Get(this->paperdoll[Shield]);
+    if (this->clas != 5 || arrows.subtype != EIF::Arrows || !this->BalanceCanEquip(bow) || !this->BalanceCanEquip(arrows)) return 1;
+    auto base = this->world->config.find("BalanceItem."+util::to_string(bow.id)+".range_tiles");
+    auto bonus = this->world->config.find("BalanceItem."+util::to_string(arrows.id)+".range_bonus");
+    return util::clamp<int>((base == this->world->config.end() ? 3 : int(base->second)) + (bonus == this->world->config.end() ? 0 : int(bonus->second)),1,10);
+}
+
+double Character::TPRecoveryRate() const
+{
+    if (!this->world->config["CombatProgression"]) return 0.0;
+    auto entry = this->world->config.find("Balance."+util::to_string(this->clas)+".tp_regen");
+    return entry == this->world->config.end() ? 0.0 : util::clamp<double>(entry->second,0.0,0.01);
+}
