+// Running is an ephemeral native state; only the elapsed enabled time is charged.
+double Character::MovementMultiplier() const
+{
+    if (!this->world->config["ClassRunRules"] || !this->running_mode || this->hp <= 0) return 1.0;
+    return this->clas == 4 ? 1.5 : 1.25;
+}
+void Character::RunStatus()
+{
+    PacketBuilder reply(PACKET_WALK, PACKET_USE, 7);
+    reply.AddShort(this->PlayerID()); reply.AddChar(this->running_mode ? 1 : 0);
+    reply.AddShort(std::max(0,int(this->tp))); reply.AddShort(int(this->MovementMultiplier()*1000));
+    if (this->map) for (Character *other : this->map->characters)
+        if (other == this || this->InRange(other)) other->Send(reply);
+}
+void Character::RunTick()
+{
+    if (!this->running_mode) return;
+    double now = Timer::GetTime();
+    double elapsed = std::max(0.0,now-this->running_charged_at);
+    this->running_charged_at = now;
+    int before = this->tp;
+    if (this->hp <= 0 || !this->map) this->running_mode = false;
+    else
+    {
+        double due = this->running_tp_fraction + elapsed * this->maxtp * 0.015;
+        int cost = int(std::min<double>(std::max(0,int(this->tp)),std::floor(due+1e-9)));
+        this->running_tp_fraction = due-cost;
+        this->tp -= cost;
+        if (this->tp <= 0) { this->running_mode=false; this->running_tp_fraction=0.0; }
+    }
+    if (this->tp != before || !this->running_mode) this->RunStatus();
+}
+void Character::SetRunning(bool enabled)
+{
+    this->RunTick(); // Repeated requests and rapid on/off cannot erase unpaid fractions.
+    bool accepted = enabled && this->world->config["ClassRunRules"] && this->hp > 0 && this->tp > 0 && !this->nowhere;
+    if (accepted && !this->running_mode) this->running_charged_at = Timer::GetTime();
+    this->running_mode = accepted;
+    this->RunStatus();
+}
