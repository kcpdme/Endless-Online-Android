+// Learned summon ownership is the persisted living bond, not an unlimited unlock.
+// Clearing every legacy summon also closes dismiss/TP/class-switch death bypasses.
+void Character::LoseCompanionBond()
+{
+    if (!this->world->config["MortalSpiritBonds"]) return;
+    this->DismissCompanion();
+    std::vector<std::pair<int,int>> lost;
+    for (const auto& spell : this->spells)
+        if (int(this->world->config["BalancePetSpell." + util::to_string(spell.id) + ".egg"]) > 0)
+            lost.emplace_back(spell.id,spell.level);
+    for (const auto& spell : lost)
+    {
+        this->skillpoints = std::min<int>(64000,this->skillpoints + spell.second);
+        this->DelSpell(spell.first);
+        if (this->spell_id == spell.first) this->CancelSpell();
+        PacketBuilder reply(PACKET_STATSKILL,PACKET_REMOVE,4);
+        reply.AddShort(spell.first); reply.AddShort(this->skillpoints); this->Send(reply);
+    }
+    if (!lost.empty()) this->StatusMsg("Your spirit died with you. Hatch a new egg to bond another pet. Spare eggs are kept.");
+}
