+long long Character::CarriedWeight() const
+{
+    long long total = 0;
+    for (const auto& item : this->inventory)
+        total += static_cast<long long>(this->world->eif->Get(item.id).weight) * std::max(0,item.amount);
+    for (auto id : this->paperdoll) total += this->world->eif->Get(id).weight;
+    return total;
+}
+
+bool Character::Overweight() const
+{
+    return this->world->config["CarryCapacityRules"] && this->CarriedWeight() > this->maxweight;
+}
+
+bool Character::TradeFits(const Character* other) const
+{
+    if (!this->world->config["CarryCapacityRules"]) return true;
+    long long total = this->CarriedWeight();
+    for (const auto& item : this->trade_inventory)
+        total -= static_cast<long long>(this->world->eif->Get(item.id).weight) * item.amount;
+    for (const auto& item : other->trade_inventory)
+        total += static_cast<long long>(this->world->eif->Get(item.id).weight) * item.amount;
+    return total <= this->maxweight;
+}
