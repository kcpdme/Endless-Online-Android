+void NPC::ActCompanion()
+{
+    double now = Timer::GetTime(); this->last_act = now;
+    Character *owner = this->map->GetCharacterPID(this->companion_owner);
+    if (!owner || owner->clas != 7 || owner->hp <= 0 || owner->nowhere
+      || !this->map->world->config["ClassIdentityRules"] || !owner->CanInteractCombat()
+      || this->map->pk || owner->arena || (this->map->world->config["GlobalPK"] && !this->map->world->PKExcept(this->map->id))
+      || now >= this->companion_expires || util::path_length(this->x,this->y,owner->x,owner->y) > 12)
+    {
+        if (owner) owner->CompanionStatus(nullptr);
+        this->Die(); return;
+    }
+    if (now >= this->companion_upkeep)
+    {
+        this->companion_upkeep = now + 2.0;
+        if (owner->tp < this->companion_cost) { owner->CompanionStatus(nullptr); this->Die(); return; }
+        owner->tp -= this->companion_cost; owner->CompanionStatus(this);
+    }
+    NPC *target = nullptr;
+    if (owner->companion_target >= 0 && now - owner->companion_command_time <= 5.0)
+    {
+        NPC *candidate = this->map->GetNPCIndex(owner->companion_target);
+        if (candidate && candidate->alive && candidate->id == owner->companion_target_type
+          && (candidate->ENF().type == ENF::Passive || candidate->ENF().type == ENF::Aggressive)
+          && util::path_length(candidate->x,candidate->y,owner->x,owner->y) <= 7) target = candidate;
+    }
+    int tx = target ? target->x : owner->x, ty = target ? target->y : owner->y;
+    int distance = util::path_length(this->x,this->y,tx,ty);
+    if (target && distance <= 1 && now - this->companion_last_attack >= 1.0)
+    {
+        this->companion_last_attack = now;
+        int base = int((5.0 + owner->level * 0.3 + owner->adj_cha * 0.22 + owner->adj_intl * 0.12) * this->companion_power);
+        std::unordered_map<std::string,double> vars;
+        owner->FormulaVars(vars); target->FormulaVars(vars,"target_");
+        vars["damage"] = util::rand(std::max(1,base-2),base+2); vars["critical"] = 0;
+        vars["modifier"] = this->map->world->config["MobRate"];
+        int amount = std::max(1,int(rpn_eval(rpn_parse(this->map->world->formulas_config["damage"]),vars)));
+        if (util::rand(0.0,1.0) > rpn_eval(rpn_parse(this->map->world->formulas_config["hit_rate"]),vars)) amount = 0;
+        amount = std::min(amount,target->hp);
+        owner->CompanionStatus(this,0,target->index,amount);
+        // Normal damage owns aggro, loot, quests and party EXP. No fake rewards.
+        // This never refreshes the owner's command; idle owners stop assistance.
+        target->Damage(owner,amount);
+        return;
+    }
+    if (distance > 1)
+    {
+        Direction horizontal = tx > this->x ? DIRECTION_RIGHT : DIRECTION_LEFT;
+        Direction vertical = ty > this->y ? DIRECTION_DOWN : DIRECTION_UP;
+        bool x_first = std::abs(tx-int(this->x)) >= std::abs(ty-int(this->y));
+        if (!this->Walk(x_first ? horizontal : vertical)) this->Walk(x_first ? vertical : horizontal);
+    }
+}
