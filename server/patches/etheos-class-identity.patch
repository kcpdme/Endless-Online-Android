+// Native owned spirits. These are session companions, never tradable NPC items.
+void Character::CompanionStatus(NPC *pet, unsigned short spell, unsigned char target, int damage)
+{
+    if (!this->map) return;
+    PacketBuilder reply(static_cast<PacketFamily>(232), PACKET_REPLY, 15);
+    reply.AddShort(this->PlayerID()); reply.AddChar(pet ? pet->index : 0);
+    reply.AddShort(pet ? pet->id : 0); reply.AddShort(this->tp);
+    reply.AddShort(pet ? util::clamp<int>(int(pet->companion_expires - Timer::GetTime()), 0, 90) : 0);
+    reply.AddShort(spell); reply.AddChar(target); reply.AddThree(std::max(0, damage));
+    for (auto *other : this->map->characters)
+        if (other == this || this->InRange(other)) other->Send(reply);
+}
+
+void Character::DismissCompanion()
+{
+    this->companion_target = -1; this->companion_command_time = 0.0;
+    if (!this->map) return;
+    std::vector<NPC*> pets;
+    for (auto *npc : this->map->npcs)
+        if (npc->companion_owner == this->PlayerID()) pets.push_back(npc);
+    for (auto *npc : pets) npc->Die();
+    if (!pets.empty()) this->CompanionStatus(nullptr);
+}
+
+void Character::CommandCompanion(NPC *target)
+{
+    if (!this->world->config["ClassIdentityRules"] || this->clas != 7 || !target) return;
+    if (target->ENF().type != ENF::Passive && target->ENF().type != ENF::Aggressive) return;
+    this->companion_target = target->index; this->companion_target_type = target->id;
+    this->companion_command_time = Timer::GetTime();
+}
+
+bool Character::CompanionSpell(unsigned short id)
+{
+    if (!this->world->config["ClassIdentityRules"]) return false;
+    std::string prefix = "BalancePetSpell." + util::to_string(id) + ".";
+    auto configured = this->world->config.find(prefix + "npc_id");
+    if (configured == this->world->config.end()) return false;
+    if (this->clas != 7 || !this->BalanceCanCast(id) || this->hp <= 0 || !this->CanInteractCombat()) return true;
+    auto existing_pet = [this]() -> NPC* {
+        for (auto *npc : this->map->npcs)
+            if (npc->companion_owner == this->PlayerID()) return npc;
+        return nullptr;
+    };
+    int definition = configured->second;
+    if (definition < 0) { this->DismissCompanion(); this->CompanionStatus(nullptr, id); return true; }
+    if (this->arena || this->map->pk || (this->world->config["GlobalPK"] && !this->world->PKExcept(this->mapid)))
+    { this->StatusMsg("Spirit companions can only be summoned outside arenas and PK areas."); this->DismissCompanion(); this->CompanionStatus(nullptr,id); return true; }
+    const ESF_Data& spell = this->world->esf->Get(id);
+    if (this->tp < spell.tp || definition <= 0 || std::size_t(definition) >= this->world->enf->data.size()) return true;
+    if (this->world->enf->Get(definition).type != 0) return true;
+    unsigned char index = this->map->GenerateNPCIndex();
+    if (index == 0 || index > 250) { this->StatusMsg("There is no room for a companion here."); this->CompanionStatus(existing_pet(),id); return true; }
+    int spawn_x = -1, spawn_y = -1;
+    for (int radius = 1; radius <= 2 && spawn_x < 0; ++radius)
+        for (int dx = -radius; dx <= radius && spawn_x < 0; ++dx)
+            for (int dy = -radius; dy <= radius; ++dy)
+            {
+                int x = int(this->x) + dx, y = int(this->y) + dy;
+                if (x < 0 || y < 0 || x > 252 || y > 252 || (dx == 0 && dy == 0)) continue;
+                if (this->map->Walkable(x,y,true) && !this->map->Occupied(x,y,Map::NPCOnly))
+                { spawn_x = x; spawn_y = y; break; }
+            }
+    if (spawn_x < 0) { this->StatusMsg("Move to an open space to summon a companion."); this->CompanionStatus(existing_pet(),id); return true; }
+    // Validate the replacement first; failure never discards an existing pet.
+    this->DismissCompanion(); this->tp -= spell.tp;
+    NPC *pet = new NPC(this->map, definition, spawn_x, spawn_y, 7, 0, index, true);
+    pet->companion_owner = this->PlayerID(); pet->companion_spell = id;
+    pet->companion_expires = Timer::GetTime() + util::clamp<double>(this->world->config["CompanionLifetimeSeconds"], 2.0, 90.0); pet->companion_upkeep = Timer::GetTime() + 2.0;
+    pet->companion_cost = this->world->config[prefix + "upkeep"];
+    pet->companion_power = this->world->config[prefix + "power"];
+    this->map->npcs.push_back(pet); pet->Spawn(); pet->act_speed = 0.35;
+    this->CompanionStatus(pet,id);
+    return true;
+}
