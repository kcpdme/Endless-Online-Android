+// Priest renewal runs independently of the world's slow ordinary recovery tick.
+void world_priest_renewal(void *world_void)
+{
+    World *world(static_cast<World*>(world_void));
+    if (!world->config["ClassSignatureRules"]) return;
+    for (Character *character : world->characters)
+    {
+        if ((character->clas != 2 && world->ecf->Get(character->clas).base != 2)
+          || character->hp <= 0 || character->hp >= character->maxhp || character->nowhere) continue;
+        double rate = character->sitting == SIT_STAND ? double(world->config["PriestRegenRate"]) : double(world->config["PriestSittingRegenRate"]);
+        rate = util::clamp<double>(rate,0.0,0.05);
+        if (character->map->pk || character->arena || (world->config["GlobalPK"] && !world->PKExcept(character->mapid))) rate *= 0.5;
+        if (rate <= 0.0) continue;
+        int gain = std::max(1,int(character->maxhp * rate));
+        character->hp = std::min<int>(character->maxhp,character->hp + gain);
+        PacketBuilder reply(PACKET_RECOVER, PACKET_PLAYER, 6);
+        reply.AddShort(character->hp);reply.AddShort(character->tp);reply.AddShort(0);character->Send(reply);
+        if (character->party) character->party->UpdateHP(character);
+    }
+}
