+// Position, class and weapon are all server-owned; never trust a client bonus.
+double Character::BackstabMultiplier(int tx, int ty, Direction facing) const
+{
+    if (!this->world->config["ClassSignatureRules"] || this->clas != 4
+      || !this->world->config["BalanceItem." + util::to_string(this->paperdoll[Weapon]) + ".backstab"]
+      || !this->BalanceCanEquip(this->world->eif->Get(this->paperdoll[Weapon]))) return 1.0;
+    const int dx[] = {0,-1,0,1}, dy[] = {1,0,-1,0};
+    int direction = int(facing);
+    if (direction < 0 || direction > 3 || int(this->x) != tx-dx[direction] || int(this->y) != ty-dy[direction]) return 1.0;
+    return util::rand(0,1) ? 2.0 : 1.5;
+}
+
+bool Character::SignatureCanCast(unsigned short id, int tx, int ty, bool targeted) const
+{
+    if (!this->world->config["ClassSignatureRules"] || this->SourceDutyAccess() > 0) return true;
+    const ESF_Data& spell = this->world->esf->Get(id);
+    if (spell.type != ESF::Damage) return true;
+    if (targeted && (this->clas == 4 || this->clas == 6) && util::path_length(this->x,this->y,tx,ty) > 1) return false;
+    if (this->clas == 5)
+    {
+        const EIF_Data& bow = this->world->eif->Get(this->paperdoll[Weapon]);
+        const EIF_Data& arrows = this->world->eif->Get(this->paperdoll[Shield]);
+        if (bow.type != EIF::Weapon || bow.subtype != EIF::Ranged || arrows.type != EIF::Shield || arrows.subtype != EIF::Arrows
+          || !this->BalanceCanEquip(bow) || !this->BalanceCanEquip(arrows)) return false;
+        if (targeted && util::path_length(this->x,this->y,tx,ty) > int(this->world->config["RangedDistance"])) return false;
+    }
+    return true;
+}
+
+bool Character::HatchCompanionEgg(unsigned short id)
+{
+    auto entry = this->world->config.find("BalanceEgg." + util::to_string(id) + ".spell");
+    const EIF_Data& item = this->world->eif->Get(id);
+    if (entry == this->world->config.end() && !(item.type == EIF::EffectPotion && item.classreq == 7)) return false;
+    unsigned short spell = entry == this->world->config.end() ? 0 : int(entry->second);
+    if (!this->world->config["ClassSignatureRules"] || !spell) this->StatusMsg("Spirit hatching is unavailable. The egg is kept.");
+    else if (this->clas != 7) this->StatusMsg("Only Summoners can hatch spirit eggs. The egg is kept.");
+    else if (!this->BalanceCanCast(spell)) this->StatusMsg("Reach the required level before hatching this egg. The egg is kept.");
+    else if (this->HasSpell(spell)) this->StatusMsg("You already know this spirit summon. The egg is kept.");
+    else if (this->HasItem(id) && this->AddSpell(spell))
+    {
+        this->DelItem(id,1);
+        PacketBuilder learned(PACKET_STATSKILL, PACKET_TAKE, 6);
+        learned.AddShort(spell); learned.AddInt(this->HasItem(1)); this->Send(learned);
+        this->StatusMsg("Spirit bonded! Its summon skill is yours permanently. Cast it to call your companion.");
+    }
+    // A real item acknowledgement also completes native refusals without loss.
+    PacketBuilder reply(PACKET_ITEM, PACKET_REPLY, 11);
+    reply.AddChar(EIF::EffectPotion); reply.AddShort(id); reply.AddInt(this->HasItem(id));
+    reply.AddChar(this->weight); reply.AddChar(this->maxweight); reply.AddShort(0); this->Send(reply);
+    return true;
+}
