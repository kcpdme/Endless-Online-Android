+void Map::SpellAreaAttack(Character *from, unsigned short spell_id)
+{
+	const ESF_Data& spell = from->world->esf->Get(spell_id);
+	if ((spell_id != 14 && spell_id != 21) || !spell || spell.type != ESF::Damage
+	 || !from->CanInteractCombat() || from->hp <= 0 || from->tp < spell.tp)
+		return;
+
+	// A 5x5 square centered on the caster, chosen from native live NPCs.
+	// Keep indices, not pointers: Damage can delete temporary NPCs on death.
+	std::vector<std::pair<int, unsigned char>> candidates;
+	UTIL_FOREACH(this->npcs, npc)
+	{
+		int dx = int(npc->x) - int(from->x), dy = int(npc->y) - int(from->y);
+		if (npc->alive && (npc->ENF().type == ENF::Passive || npc->ENF().type == ENF::Aggressive)
+		 && std::abs(dx) <= 2 && std::abs(dy) <= 2)
+			candidates.push_back(std::make_pair(dx * dx + dy * dy, npc->index));
+	}
+	std::sort(candidates.begin(), candidates.end());
+	if (candidates.size() > 5) candidates.resize(5);
+
+	from->tp -= spell.tp; // Exactly one native cost, including an empty area.
+	unsigned char hits = 0;
+	for (const auto& candidate : candidates)
+	{
+		NPC *npc = this->GetNPCIndex(candidate.second);
+		if (!npc || !npc->alive) continue;
+		this->SpellAttack(from, npc, spell_id, false);
+		++hits;
+	}
+
+	// Explicit completion also ends empty casts. Standard damage/kill packets
+	// still own every hit, drop, EXP reward and quest kill-credit update.
+	PacketBuilder result(PACKET_AREA, PACKET_REPLY, 9);
+	result.AddShort(from->PlayerID());
+	result.AddShort(spell_id);
+	result.AddChar(from->x);
+	result.AddChar(from->y);
+	result.AddShort(from->tp);
+	result.AddChar(hits);
+	UTIL_FOREACH(this->characters, character)
+		if (character == from || from->InRange(character)) character->Send(result);
+}
