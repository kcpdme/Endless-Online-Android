+}
+
+void Character::StartCompanionCooldown()
+{
+    if (!this->world->config["PermanentPetCollection"]) return;
+    bool owned = false;
+    for (const auto& spell : this->spells)
+        if (int(this->world->config["BalancePetSpell." + util::to_string(spell.id) + ".egg"]) > 0) { owned = true; break; }
+    if (!owned) return;
+    this->companion_ready_at = std::max(this->companion_ready_at, int(std::time(0)) + util::clamp<int>(this->world->config["PetCollectionCooldownSeconds"], 1, 300));
+    this->SaveCompanionState();
+}
