+
+bool Character::BalanceCanEquip(const EIF_Data& item) const
+{
+	if (!this->world->config["BalanceRevamp"] || item.id == 0) return true;
+	if (item.id == 491 && this->SourceDutyAccess() == 0) return false;
+	const ECF_Data& ecf = this->world->ecf->Get(this->clas);
+	return this->level >= item.levelreq
+	 && (!item.classreq || this->clas == item.classreq || ecf.base == item.classreq)
+	 && (item.type != EIF::Armor || item.gender == this->gender);
+}
+
+bool Character::BalanceCanCast(unsigned short id) const
+{
+	if (!this->world->config["BalanceRevamp"]) return true;
+	if (this->SourceDutyAccess() > 0) return true;
+	std::string prefix = "BalanceSpell." + util::to_string(id) + ".";
+	auto required = this->world->config.find(prefix + "level");
+	if (required == this->world->config.end() || this->level < int(required->second)) return false;
+	std::string allowed = this->world->config[prefix + "classes"];
+	if (allowed.empty()) return true;
+	const ECF_Data& ecf = this->world->ecf->Get(this->clas);
+	for (const auto& value : util::explode(',', allowed))
+	{
+		int clas = util::to_int(value);
+		if (clas > 0 && (this->clas == clas || ecf.base == clas)) return true;
+	}
+	return false;
+}
+
+int Character::BalanceAreaRadius(unsigned short id) const
+{
+	if (!this->world->config["BalanceRevamp"]) return (id == 14 || id == 21) ? 2 : 0;
+	return util::clamp<int>(this->world->config["BalanceSpell." + util::to_string(id) + ".radius"], 0, 2);
+}
+
+int Character::BalanceAreaTargets(unsigned short id) const
+{
+	if (!this->world->config["BalanceRevamp"]) return 5;
+	return util::clamp<int>(this->world->config["BalanceSpell." + util::to_string(id) + ".targets"], 1, 5);
+}
+
+int Character::SpellDamageAmount(unsigned short id, bool maximum)
+{
+	const ESF_Data& spell = this->world->esf->Get(id);
+	int attack = maximum ? this->maxdam : this->mindam;
+	int base = maximum ? spell.maxdam : spell.mindam;
+	if (!this->world->config["BalanceRevamp"]) return attack + base + this->SpellLevel(id);
+	int clas = this->clas == 0 ? 1 : this->clas;
+	double scale = this->world->config["Balance." + util::to_string(clas) + ".spell_scale"];
+	int amount = int(attack * std::max(1.0, scale)) + base + 2 * std::min<int>(10, this->SpellLevel(id));
+	int radius = this->BalanceAreaRadius(id);
+	if (radius > 0) amount = int(amount * (radius == 1 ? 0.8 : 0.6));
+	return util::clamp<int>(amount, 1, 32000);
+}
+
+int Character::SpellHealAmount(unsigned short id)
+{
+	const ESF_Data& spell = this->world->esf->Get(id);
+	if (!this->world->config["BalanceRevamp"]) return spell.hp + this->SpellLevel(id);
+	int clas = this->clas == 0 ? 1 : this->clas;
+	std::string prefix = "Balance." + util::to_string(clas) + ".heal_";
+	int bonus = int(this->adj_wis * double(this->world->config[prefix + "wis"])
+	 + this->adj_intl * double(this->world->config[prefix + "int"])
+	 + this->adj_cha * double(this->world->config[prefix + "cha"]));
+	return util::clamp<int>(spell.hp + bonus + 2 * std::min<int>(10, this->SpellLevel(id)), 0, 32000);
 }
 
